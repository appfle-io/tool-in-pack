{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TIP",
  "version": "1.12.0",
  "identifier": "io.appfle.tip",
  "build": {
    "frontendDist": "../dist-web",
    "beforeBuildCommand": "sh scripts/collect-web.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "TIP · TOOL-IN-PACK",
        "width": 1040,
        "height": 760,
        "minWidth": 420,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.icns"
    ],
    "category": "Productivity",
    "shortDescription": "작은 도구들을 한곳에 모은 모듈형 유틸리티",
    "longDescription": "PDF·HWP 문서 읽기, 이미지 변환, PDF 합치기, QR 생성 등 20가지 작은 도구와 클립보드 히스토리·노치 아일랜드·빠른 실행 검색·배송 조회를 기기 안에서만 처리하는 데스크톱 앱입니다.",
    "copyright": "© 2026 유동규",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "dmg": {
        "windowSize": {
          "width": 660,
          "height": 400
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    }
  }
}
